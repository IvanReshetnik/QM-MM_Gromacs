d1: DISTANCE ATOMS=1,9
d2: DISTANCE ATOMS=8,9
d:  COMBINE ARG=d1,d2 COEFFICIENTS=1,-1 PERIODIC=NO

METAD ...
  LABEL=metad
  ARG=d
  PACE=200
  HEIGHT=0.5
  SIGMA=0.02
  GRID_MIN=-0.15
  GRID_MAX=0.15
  FILE=HILLS
  BIASFACTOR=7.
  TEMP=300.
... METAD

PRINT ARG=d,metad.bias STRIDE=200 FILE=plumed.xvg

