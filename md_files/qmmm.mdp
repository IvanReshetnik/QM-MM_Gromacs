integrator               = md
tinit                    = 0
dt                       = 0.0005
nsteps                   = 200000
comm-mode                = Linear
comm-grps                = System
nstcomm                  = 20

nstxout                  = 0
nstxtcout                = 20
xtc_grps                 = MAL
nstvout                  = 0
nstfout                  = 0
nstlog                   = 20
nstenergy                = 20

cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
rlist                    = 1.0

coulombtype              = PME
rcoulomb                 = 0.9
vdwtype                  = Cut-off
rvdw                     = 0.9
DispCorr                 = No

Tcoupl                   = Nose-Hoover
tc-grps                  = System
tau-t                    = 0.5
ref-t                    = 300.
nsttcouple               = 1

Pcoupl                   = Parrinello-Rahman
tau-p                    = 0.5
compressibility          = 4.5e-5
ref-p                    = 1.
refcoord-scaling         = all
nstpcouple               = 1

QMMM                     = yes
QMMM-grps                = MAL
QMmethod                 = RHF
QMbasis                  = STO-3G
QMcharge                 = 0
QMmult                   = 1
MMChargeScaleFactor      = 1

constraints              = none

