integrator              = md
nsteps                  = 50000
dt                      = 0.001
comm-mode               = Linear
nstcomm                 = 1
comm_grps               = System

nstxout                 = 100
nstvout                 = 100
nstenergy               = 10
nstlog                  = 10

continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

cutoff-scheme           = Verlet
ns_type                 = grid
nstlist                 = 10
rcoulomb                = 0.9
rvdw                    = 0.9
DispCorr                = EnerPres

coulombtype             = PME
pme_order               = 4
fourierspacing          = 0.16

tcoupl                  = Berendsen
tc-grps                 = System
tau_t                   = 0.2
ref_t                   = 300

pcoupl                  = no
pbc                     = xyz

gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
